params {
    max_memory                = 488.GB
    max_cpus                  = 64
    max_time                  = 240.h
    compute_multiplier        = 1
}

process {
    executor = 'awsbatch'
    errorStrategy = 'retry'
    maxRetries = 5

    // Resource limits (Nextflow 24.x+)
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    // DeepSomatic GPU process
    // Parabricks DeepSomatic requires GPU and substantial resources for WGS processing
    // Uses OnDemand queue for consistent availability (Spot can queue 1-3h+ for 4-GPU capacity)
    withName: 'DEEPSOMATIC' {
        accelerator   = 1
        cpus          = { 16 * params.compute_multiplier * task.attempt }
        memory        = { 100.GB * params.compute_multiplier * task.attempt }
        time          = { 24.h * params.compute_multiplier }
        queue         = env('PW_ONDEMAND_JOB_QUEUE')

        // Retry only on transient/resource exit codes (exit 130-145: SIGKILL/SIGTERM, 104: connection reset, 175-177: AWS-specific)
        // Permanent failures (bad input, corrupt BAMs) fail immediately on 2nd attempt
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
        maxRetries    = 2

        ext.args      = { [
            "--num-streams-per-gpu ${params.num_streams_per_gpu}",
            params.enable_gvcf ? '--run-deepsomatic-gvcf' : ''
        ].findAll { it }.join(' ').trim() }
    }
}

aws {
    region = 'us-east-1'
    batch {
        // GPU instance selection (A10 is balanced cost/speed)
        //
        // Options:
        // - 't4':  ~$0.35/hr, 4-6hr for WGS, cheapest but slowest
        // - 'a10': ~$1.76/hr, 2-3hr for WGS, balanced (RECOMMENDED)
        // - 'h100': ~$4.77/hr, 30min-1hr for WGS, fastest but expensive
        //
        // For production, use OnDemand (wired via queue parameter above) to avoid
        // multi-hour Spot queueing delays for 4-GPU instances
        instanceTypes = ['a10']
    }
}

docker {
    registry = 'quay.io'
    enabled  = true
}

apptainer {
    registry = 'quay.io'
    enabled  = false
}
